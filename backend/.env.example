# --- Supabase (proyecto NOVA COURSE) ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Supabase > Connect > "Session pooler" (copia la cadena y pon tu contraseña de la base de datos)
# Es PRIVADA: solo va en el servidor, nunca en la web.
DATABASE_URL=postgresql://postgres.TU-PROYECTO:TU-CONTRASEÑA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# --- Dirección de la web ---
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Wompi: Dashboard de comercios > Desarrolladores ---
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_API_URL=https://sandbox.wompi.co/v1
# true = permite simular pagos mientras no haya llaves de Wompi. En producción: false
PAYMENTS_DEMO_MODE=true

# --- Firma del certificado ---
CERT_SIGNER_NAME=Director Académico
CERT_SIGNER_TITLE=Orion Nova Technologies
